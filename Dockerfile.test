# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS node
FROM oven/bun:1.3.14 AS bun
# Release maintenance tests need `git diff --default-prefix`, absent in bookworm.
FROM rust:1.96.1-trixie

ARG TARGETARCH
ARG ZIG_VERSION=0.16.0
ARG JUST_VERSION=1.40.0
ARG NEXTEST_VERSION=0.9.114
ARG XWIN_VERSION=0.10.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gdb git openssh-client pkg-config \
    python3 ripgrep strace unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN case "${TARGETARCH}" in \
        amd64) zig_arch=x86_64 ;; \
        arm64) zig_arch=aarch64 ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl --fail --location --retry 3 \
        "https://ziglang.org/download/${ZIG_VERSION}/zig-${zig_arch}-linux-${ZIG_VERSION}.tar.xz" \
        -o /tmp/zig.tar.xz \
    && mkdir /opt/zig \
    && tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 \
    && rm /tmp/zig.tar.xz \
    && ln -s /opt/zig/zig /usr/local/bin/zig

RUN rustup component add rustfmt clippy \
    && cargo install --locked just --version "${JUST_VERSION}" \
    && cargo install --locked cargo-nextest --version "${NEXTEST_VERSION}" \
    && cargo install --locked xwin --version "${XWIN_VERSION}" \
    && rustup target add x86_64-pc-windows-msvc \
    && rm -rf /usr/local/cargo/registry /usr/local/cargo/git

# Keep build products separate from the source, including when bind mounting it.
ENV CARGO_TARGET_DIR=/var/cache/herdr/target \
    ZIG_GLOBAL_CACHE_DIR=/var/cache/herdr/zig \
    ZIG_LOCAL_CACHE_DIR=/var/cache/herdr/zig-local \
    RUST_BACKTRACE=1
WORKDIR /workspace
COPY . .
CMD ["just", "test"]
